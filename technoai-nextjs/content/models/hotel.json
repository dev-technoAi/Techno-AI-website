on, and cloud management to automate guest services efficiently."}]},{"blocks":[{"t":"h","level":2,"html":"APPLICATIONS"},{"t":"h","level":2,"html":"Ideal For"},{"t":"icon","svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" id=\"Layer_1\" x=\"0px\" y=\"0px\" viewBox=\"0 0 512 512\" style=\"enable-background:new 0 0 512 512;\" xml:space=\"preserve\"><g>\t<g>\t\t<path d=\"M145.046,230.404H85.321c-4.712,0-8.532,3.82-8.532,8.532v85.321c0,4.712,3.82,8.532,8.532,8.532h59.725   c4.712,0,8.532-3.82,8.532-8.532v-85.321C153.578,234.224,149.758,230.404,145.046,230.404z M136.514,315.725H93.853v-68.257   h42.661V315.725z\"></path>\t</g></g><g>\t<g>\t\t<path d=\"M290.091,230.404h-59.725c-4.712,0-8.532,3.82-8.532,8.532v85.321c0,4.712,3.82,8.532,8.532,8.532h59.725   c4.712,0,8.532-3.82,8.532-8.532v-85.321C298.623,234.224,294.803,230.404,290.091,230.404z M281.559,315.725h-42.66v-68.257   h42.66V315.725z\"></path>\t</g></g><g>\t<g>\t\t<path d=\"M290.091,366.917h-59.725c-4.712,0-8.532,3.82-8.532,8.532v85.321c0,4.712,3.82,8.532,8.532,8.532h59.725   c4.712,0,8.532-3.82,8.532-8.532v-85.321C298.623,370.738,294.803,366.917,290.091,366.917z M281.559,452.238h-42.66v-68.257   h42.66V452.238z\"></path>\t</g></g><g>\t<g>\t\t<path d=\"M426.605,230.404H366.88c-4.712,0-8.532,3.82-8.532,8.532v85.321c0,4.712,3.82,8.532,8.532,8.532h59.725   c4.712,0,8.532-3.82,8.532-8.532v-85.321C435.137,234.224,431.317,230.404,426.605,230.404z M418.073,315.725h-42.66v-68.257   h42.66V315.725z\"></path>\t</g></g><g>\t<g>\t\t<path d=\"M145.046,366.917H85.321c-4.712,0-8.532,3.82-8.532,8.532v85.321c0,4.712,3.82,8.532,8.532,8.532h59.725   c4.712,0,8.532-3.82,8.532-8.532v-85.321C153.578,370.738,149.758,366.917,145.046,366.917z M136.514,452.238H93.853v-68.257   h42.661V452.238z\"></path>\t</g></g><g>\t<g>\t\t<path d=\"M426.605,366.917H366.88c-4.712,0-8.532,3.82-8.532,8.532v85.321c0,4.712,3.82,8.532,8.532,8.532h59.725   c4.712,0,8.532-3.82,8.532-8.532v-85.321C435.137,370.738,431.31